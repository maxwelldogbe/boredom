# Copy to .env (or set in your host's dashboard). Never commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated host names the server answers to (also used for WebSocket origin checks).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins of the React client.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Port for daphne in production: daphne -b 0.0.0.0 -p $PORT config.asgi:application
PORT=8000

# Copy to .env (or set in your host's dashboard). Never commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated host names the server answers to (also used for WebSocket origin checks).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins of the React client.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Port for daphne in production: daphne -b 0.0.0.0 -p $PORT config.asgi:application
PORT=8000
# SMS (Teleconic) for "Forgot password?" codes. Without SMS_API_KEY nothing is sent (with
# DJANGO_DEBUG=true the code is written to the server log instead).
SMS_API_KEY=TCSMS_CGzB0HrFrwKVBwRohY20rrtObBTDI73A2lajKI2i
# Your approved sender ID (max 11 characters); empty uses your first approved one.
SMS_SENDER_ID=BRAINARTZ
# SMS_API_URL=https://sms.teleconic.com/api/v1

# Production only. In dev (npm run dev) these stay unset and Vite proxies /api and /ws
# to the backend at http://localhost:8000.
# Full WebSocket URL of the backend, including the /ws/ path.
VITE_WS_URL=wss://boredom-api.example.com/ws/
# Base URL of the backend HTTP API (no trailing slash). /api/health is appended.
VITE_API_URL=https://boredom-api.example.com
